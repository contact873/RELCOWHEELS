# Set these in .env.local. Until they exist the app runs on the seed data in src/lib/seed.ts,
# so every page renders and the build passes without a Supabase project.

# Supabase dashboard, Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where the site reads from. "sample" until src/lib/queries.ts actually queries Supabase. Set this to
# "database" only when that is true, or the site will claim to be live while still showing placeholder
# cars. See src/lib/data-source.ts.
NEXT_PUBLIC_DATA_SOURCE=sample

# Canonical origin. Must match the canonical tags in the pages.
NEXT_PUBLIC_SITE_URL=https://wheels.relcoai.com

# WhatsApp lead delivery. The number a dealer's leads are forwarded from.
LEAD_WHATSAPP_SENDER=
