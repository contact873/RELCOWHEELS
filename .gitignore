# Next.js
.next/
out/
node_modules/
next-env.d.ts
*.tsbuildinfo

# Environment. Never commit a Supabase service key.
.env
.env.local
.env*.local

# Build scratch
.build/
.DS_Store
*.log

# Generated dealer stock. Deliberately not tracked: these files carry dealer contact details,
# real prices and real registration numbers, and they are derived from a CSV that is itself the
# record. Treat a stock file like a customer list, not like source code.
stock/

# VibeGuard writes these into the project root whenever it scans, without being asked.
# The cache is transient, the report filename carries a timestamp, and a baseline records the
# absolute repo path of whichever machine produced it, which is not something to share.
# If a shared baseline is ever wanted, create it deliberately and un-ignore baselines/.
.vibeguard/cache/
.vibeguard/baselines/
vibeguard-report-*.html
